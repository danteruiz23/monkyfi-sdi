# Copy to .env and fill in locally. Never commit .env. Names only — no values here.

# Supabase (Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Model provider layer: which provider the agent uses (meta | gemini)
MODEL_PROVIDER=

# Muse Spark 1.1 via Meta Model API (OpenAI SDK-compatible)
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_NAME=

# Gemini (second model, for comparison)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=

# Defaults
DEFAULT_LANGUAGE=
DEFAULT_TIMEZONE=
