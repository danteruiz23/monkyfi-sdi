# Copy to .env and fill in locally. Never commit .env. Names only — no values here.

# Supabase (Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Model provider layer: which provider the agent uses (meta | gemini)
MODEL_PROVIDER=

# Muse Spark 1.1 via Meta Model API (OpenAI SDK-compatible)
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_NAME=

# Gemini (comparison model, D36; called through its OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=

# Defaults
DEFAULT_LANGUAGE=
DEFAULT_TIMEZONE=

# Web view (Phase 3, read-only): folder with <order>/v<N>/extraction.json and validation.json,
# relative to the repo root. Optional; when empty the view reads runs/phase3-view.
SDI_VIEW_DATA_DIR=
