{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/audit_event.schema.json",
  "title": "audit_event",
  "description": "Append-only log of decisions, corrections and external actions (RF09).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "actor",
    "action",
    "entity",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "before": {},
    "after": {},
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "rules_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
