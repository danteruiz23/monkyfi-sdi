{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/customer.schema.json",
  "title": "customer",
  "description": "The carrier's client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "name",
    "type",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "enterprise",
        "hyperscaler"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
