{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/dependency.schema.json",
  "title": "dependency",
  "description": "What an order or milestone waits on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "service_order_id",
    "kind",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "from_milestone_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "to_milestone_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "internal",
        "supplier",
        "customer"
      ]
    },
    "shared_resource_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "supplier_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
