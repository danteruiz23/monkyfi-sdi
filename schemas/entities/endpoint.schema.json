{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/endpoint.schema.json",
  "title": "endpoint",
  "description": "A or Z end of an order version. Site data are field_value rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "order_version_id",
    "side",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "side": {
      "enum": [
        "A",
        "Z"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
