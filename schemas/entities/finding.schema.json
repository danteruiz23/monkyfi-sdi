{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/finding.schema.json",
  "title": "finding",
  "description": "A discrepancy or gap detected by a rule, including its resolving action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "service_order_id",
    "order_version_id",
    "rule_id",
    "severity",
    "conflicting_values",
    "evidence",
    "impact",
    "status",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "rule_id": {
      "type": "string"
    },
    "field_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "info"
      ]
    },
    "conflicting_values": {},
    "evidence": {},
    "impact": {
      "enum": [
        "confirmed",
        "possible"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolving_party": {
      "type": [
        "string",
        "null"
      ],
      "description": "Who must provide or fix the data (D46); the finding is escalated to this party."
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "overridden"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
