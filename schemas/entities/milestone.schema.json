{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/milestone.schema.json",
  "title": "milestone",
  "description": "Plan milestone. Requested, forecast and committed dates are separate columns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "service_order_id",
    "name",
    "is_critical",
    "forecast_status",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_critical": {
      "type": "boolean"
    },
    "requested_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "forecast_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "forecast_assumptions": {
      "type": [
        "string",
        "null"
      ]
    },
    "forecast_status": {
      "enum": [
        "pending",
        "estimated",
        "not_estimable"
      ]
    },
    "committed_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "commitment_approval_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
