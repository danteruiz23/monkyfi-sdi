{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/order_version.schema.json",
  "title": "order_version",
  "description": "Each version of an order as received.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "service_order_id",
    "version_no",
    "received_at",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_order_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_no": {
      "type": "integer"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
