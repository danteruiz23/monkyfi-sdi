{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/project.schema.json",
  "title": "project",
  "description": "Groups the orders of one customer (D03).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "customer_id",
    "name",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
