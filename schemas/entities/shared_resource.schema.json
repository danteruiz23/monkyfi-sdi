{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/shared_resource.schema.json",
  "title": "shared_resource",
  "description": "Resource common to several orders, e.g. one cross-connect request (D03).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "kind",
    "description",
    "is_blocked",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_blocked": {
      "type": "boolean"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
