{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/supplier.schema.json",
  "title": "supplier",
  "description": "Third party a dependency waits on (D15).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "name",
    "follow_up_threshold_days",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "follow_up_threshold_days": {
      "type": "integer",
      "description": "Days without a response before a follow-up is due (UC05)."
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
