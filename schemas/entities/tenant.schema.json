{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities/tenant.schema.json",
  "title": "tenant",
  "description": "A carrier. Basis of tenant segregation (RLS).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "True for every synthetic row (CLAUDE.md rule 3)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
