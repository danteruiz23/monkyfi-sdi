{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field_rules.schema.json",
  "title": "Critical-field rules file (rules/fields.*.json)",
  "type": "object",
  "required": ["rules_version", "applies_to", "fields"],
  "properties": {
    "rules_version": {"type": "string"},
    "applies_to": {"type": "array", "items": {"enum": ["EPL", "WAVELENGTH"]}, "minItems": 1},
    "status": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "group", "scope", "requirement", "value_type", "authoritative_source", "gate", "missing_severity"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
          "group": {"type": "string"},
          "scope": {"enum": ["order", "endpoint"]},
          "requirement": {"enum": ["required", "conditional"]},
          "applies_when": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "required": ["field", "equals"], "additionalProperties": false, "properties": {"field": {"type": "string"}, "equals": {"type": "string"}}},
              {"type": "object", "required": ["field", "present"], "additionalProperties": false, "properties": {"field": {"type": "string"}, "present": {"const": true}}}
            ]
          },
          "condition": {"type": "string"},
          "value_type": {"enum": ["string", "enum", "speed", "date", "boolean", "duration", "integer", "list", "contact"]},
          "enum": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "string"}},
          "authoritative_source": {"enum": ["quote", "order_form", "technical_annex", "loa_cfa", "email", "carrier_plan"]},
          "gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5"]},
          "missing_severity": {"enum": ["critical", "high", "medium", "info"]}
        },
        "if": {"properties": {"requirement": {"const": "conditional"}}},
        "then": {"required": ["applies_when", "condition"]}
      }
    }
  }
}
