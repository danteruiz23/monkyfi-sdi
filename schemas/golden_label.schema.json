{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golden_label.schema.json",
  "title": "Golden label for one synthetic order (golden.json)",
  "description": "Known-correct answers for one version of one synthetic order, produced by the generator from the seeded defects. expected_status uses the field_value statuses; 'pending' means extracted and consistent but not yet verified by its data owner, or a value that is still awaited. G1 never requires 'verified' (D28).",
  "type": "object",
  "required": [
    "synthetic",
    "synthetic_mark",
    "order",
    "mandatory_cases",
    "documents",
    "expected_fields",
    "expected_findings",
    "expected_gate",
    "expected_later_gates",
    "expected_dates",
    "expected_dependencies",
    "expected_version_change",
    "shared_resources",
    "adversarial",
    "seeded_defects"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "doc_id",
        "page",
        "location",
        "raw_value"
      ],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string"
        },
        "raw_value": {
          "type": "string"
        }
      }
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "info"
      ]
    },
    "case": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 16
    }
  },
  "properties": {
    "synthetic": {
      "const": true
    },
    "synthetic_mark": {
      "const": "SYNTHETIC — NOT REAL DATA"
    },
    "order": {
      "type": "object",
      "required": [
        "external_order_id",
        "product",
        "version_no",
        "received_at",
        "stage",
        "tenant",
        "customer",
        "customer_type",
        "project",
        "split",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "external_order_id": {
          "type": "string"
        },
        "product": {
          "enum": [
            "EPL",
            "WAVELENGTH"
          ]
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "tenant": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "customer_type": {
          "enum": [
            "enterprise",
            "hyperscaler"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "enum": [
            "dev",
            "eval",
            "adversarial"
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "stage": {
          "enum": [
            "order_received",
            "testing_completed",
            "delivered_pending_acceptance"
          ]
        },
        "category": {
          "enum": [
            "clean",
            "defect",
            "adversarial"
          ]
        }
      }
    },
    "mandatory_cases": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "doc_type",
          "filename",
          "pages",
          "stale",
          "foreign"
        ],
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "doc_type": {
            "enum": [
              "quote",
              "order_form",
              "technical_annex",
              "loa_cfa",
              "email",
              "test_report"
            ]
          },
          "filename": {
            "type": "string",
            "pattern": "\\.pdf$"
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "stale": {
            "type": "boolean",
            "description": "Not reissued for this version; still the previous version's document."
          },
          "foreign": {
            "type": "boolean",
            "description": "Belongs to another customer (adversarial)."
          }
        }
      }
    },
    "expected_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_key",
          "expected_status",
          "raw_value",
          "normalized_value",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "field_key": {
            "type": "string"
          },
          "expected_status": {
            "enum": [
              "verified",
              "pending",
              "missing",
              "not_applicable",
              "contradictory",
              "stale"
            ]
          },
          "raw_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalized_value": {},
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "rule_id",
          "field_key",
          "severity",
          "mandatory_case",
          "conflicting_values",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "field_key": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "mandatory_case": {
            "$ref": "#/$defs/case"
          },
          "conflicting_values": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "expected_gate": {
      "type": "object",
      "required": [
        "gate",
        "recommendation",
        "blocking_finding_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "gate": {
          "const": "G1"
        },
        "recommendation": {
          "enum": [
            "pass",
            "block"
          ]
        },
        "blocking_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_later_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "recommendation",
          "unmet_requirements",
          "mandatory_case"
        ],
        "properties": {
          "gate": {
            "enum": [
              "G3",
              "G4"
            ]
          },
          "recommendation": {
            "enum": [
              "pass",
              "block"
            ]
          },
          "unmet_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mandatory_case": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "expected_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "page",
          "location",
          "raw_value",
          "date",
          "type",
          "scope",
          "is_commitment",
          "mandatory_case",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "raw_value": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "enum": [
              "requested",
              "forecast",
              "committed"
            ]
          },
          "is_commitment": {
            "type": "boolean",
            "description": "True only for the carrier's committed date for the order."
          },
          "mandatory_case": {
            "$ref": "#/$defs/case"
          },
          "note": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "enum": [
              "order",
              "supplier_dependency"
            ],
            "description": "A supplier's own commitment stays on the dependency; only the carrier's commitment to the customer is the order's committed date (D26)."
          }
        }
      }
    },
    "expected_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "source_doc_id",
          "kind",
          "supplier",
          "description",
          "supplier_date",
          "supplier_date_type",
          "order_forecast_status",
          "follow_up_expected",
          "mandatory_case",
          "note"
        ],
        "properties": {
          "dependency_id": {
            "type": "string"
          },
          "source_doc_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "internal",
              "supplier",
              "customer"
            ]
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "supplier_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "supplier_date_type": {
            "enum": [
              "forecast",
              "committed",
              null
            ]
          },
          "order_forecast_status": {
            "enum": [
              "estimable",
              "not_estimable"
            ]
          },
          "follow_up_expected": {
            "type": "boolean"
          },
          "mandatory_case": {
            "$ref": "#/$defs/case"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "expected_version_change": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous_version_no",
            "previous_gate_recommendation",
            "changed_fields",
            "reopened_validations",
            "milestone_impact_expected",
            "milestone_impact_note"
          ],
          "properties": {
            "previous_version_no": {
              "type": "integer",
              "minimum": 1
            },
            "previous_gate_recommendation": {
              "enum": [
                "pass",
                "block"
              ]
            },
            "changed_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field_key",
                  "previous",
                  "current"
                ],
                "properties": {
                  "field_key": {
                    "type": "string"
                  },
                  "previous": {
                    "type": "string"
                  },
                  "current": {
                    "type": "string"
                  }
                }
              }
            },
            "reopened_validations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only these field validations are reopened (UC03)."
            },
            "milestone_impact_expected": {
              "type": "boolean"
            },
            "milestone_impact_note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "shared_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shared_resource_id",
          "kind",
          "description",
          "is_blocked",
          "linked_order_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "shared_resource_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "is_blocked": {
            "type": "boolean"
          },
          "linked_order_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "adversarial": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attack",
            "doc_id",
            "location",
            "content",
            "expected_behavior",
            "forbidden_outcomes"
          ],
          "properties": {
            "attack": {
              "enum": [
                "other_customer_document",
                "embedded_instruction"
              ]
            },
            "doc_id": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "expected_behavior": {
              "type": "string"
            },
            "forbidden_outcomes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "seeded_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "defect_type",
          "field",
          "description"
        ],
        "properties": {
          "defect_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
